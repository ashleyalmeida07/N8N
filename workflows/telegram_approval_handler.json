    {
      "parameters": {
        "jsCode": "// Parse Telegram callback query\nvar raw = $input.first().json;\nvar body = raw.body || raw;\nvar callback = body.callback_query;\n\nif (!callback || !callback.data) return [];\n\nvar action = callback.data;\nvar callbackId = callback.id;\nvar chatId = String(callback.message.chat.id);\nvar msgText = callback.message.caption || '';\n\n// Parse media URL from 📎\nvar mediaUrl = '';\nvar urlParts = msgText.split('📎');\nif (urlParts.length > 1) {\n  mediaUrl = urlParts[1].trim();\n}\n\n// Parse title from 📌\nvar title = '';\nvar titleParts = msgText.split('📌');\nif (titleParts.length > 1) {\n  title = titleParts[1].split('\\n')[0].trim();\n}\n\n// Detect media type from 🎬\nvar mediaType = 'image';\nif (msgText.includes('🎬 video')) {\n  mediaType = 'video';\n}\n\n// Generate Instagram caption (no location in text)\nvar instagramCaption = title + ' 😂🔥\\n\\n#memes #funny #viral #trending #lol #memesdaily #humor #comedy #instamemes #relatable';\n\nvar answerText = action === 'approve' ? '📤 Posting to Instagram...' : '📝 Saving as draft...';\nvar answerBody = JSON.stringify({\n  callback_query_id: callbackId,\n  text: answerText\n});\n\nreturn [{\n  json: {\n    action: action,\n    callbackId: callbackId,\n    chatId: chatId,\n    mediaUrl: mediaUrl,\n    mediaType: mediaType,\n    title: title,\n    instagramCaption: instagramCaption,\n    answerBody: answerBody\n  }\n}];"
      },
      "id": "node-parse",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
