      "parameters": {
        "jsCode": "var raw = $input.first().json;\nvar body = raw.body || raw;\nvar callback = body.callback_query;\nif (!callback || !callback.data) return [];\n\nvar action = callback.data;\nvar callbackId = callback.id;\nvar chatId = String(callback.message.chat.id);\nvar msgText = callback.message.caption || '';\n\nvar imageUrl = '';\nvar urlParts = msgText.split('📎');\nif (urlParts.length > 1) imageUrl = urlParts[1].trim();\n\nvar title = '';\nvar titleParts = msgText.split('📌');\nif (titleParts.length > 1) title = titleParts[1].split('\\n')[0].trim();\n\n// Skip bad titles: too short, has underscores (subreddit names), or generic\nvar badTitles = ['me_irl', 'meirl', 'memes', 'meme', 'funny', 'lol', 'bruh', 'oc', 'title'];\nvar isGoodTitle = title.length > 10 && !title.includes('_') && badTitles.indexOf(title.toLowerCase()) === -1;\n\n// Fun captions to rotate when title is bad\nvar funCaptions = ['Tag someone who needs to see this 😂', 'This is too accurate 💀😂', 'I cant stop laughing 🤣🔥', 'Who else can relate? 😭😂', 'Bro this is so true 😂💯', 'Send this to your bestie 😂🫡', 'POV: You saw this and lost it 💀', 'This one hits different 😂🎯'];\nvar randomCaption = funCaptions[Math.floor(Math.random() * funCaptions.length)];\n\nvar captionText = isGoodTitle ? title + ' 😂🔥' : randomCaption;\n\nvar instagramCaption = captionText + '\\n.\\n.\\n.\\n#memes #funny #viral #trending #lol #memesdaily #humor #comedy #instamemes #relatable #dailymemes #funnymemes #memepage #explore #explorepage #memeoftheday #laugh #hilarious #jokes #dankmemes #funnyvideos #memesdank #comedymemes #trendingmemes #viralpost';\n\n// Build Cloudinary URL: upscale to 1080px + heliomeme watermark (small, transparent, bottom-right)\nvar processedUrl = 'https://res.cloudinary.com/rd4afqls/image/fetch/c_scale,w_1080,q_auto:best/l_text:Arial_12_bold:heliomeme,co_white,o_25,g_south_east,x_8,y_8/' + imageUrl;\n\nvar answerBody = JSON.stringify({\n  callback_query_id: callbackId,\n  text: action === 'approve' ? '📤 Upscaling & posting to Instagram...' : '📝 Saving as draft...'\n});\n\nreturn [{ json: { action: action, callbackId: callbackId, chatId: chatId, imageUrl: imageUrl, processedUrl: processedUrl, instagramCaption: instagramCaption, answerBody: answerBody } }];"
      },
