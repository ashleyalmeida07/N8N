    {
      "parameters": {
        "jsCode": "// Parse Telegram callback query\nvar body = $input.first().json;\nvar callback = body.callback_query;\n\n// Exit if not a valid callback\nif (!callback || !callback.data) return [];\n\nvar action = callback.data;\nvar callbackId = callback.id;\nvar chatId = String(callback.message.chat.id);\nvar msgText = callback.message.caption || '';\n\n// --- Parse caption from Telegram message ---\nvar caption = '';\nvar ci = msgText.indexOf('Caption:');\nif (ci !== -1) {\n  var afterCaption = msgText.substring(ci + 8);\n  var tagIdx = afterCaption.indexOf('🏷️');\n  if (tagIdx !== -1) {\n    caption = afterCaption.substring(0, tagIdx).trim();\n  } else {\n    caption = afterCaption.split('\\n\\n')[0].trim();\n  }\n}\n\n// --- Parse hashtags ---\nvar hashtags = '';\nvar tagParts = msgText.split('🏷️');\nif (tagParts.length > 1) {\n  var hPart = tagParts[1];\n  var scoreIdx = hPart.indexOf('📊');\n  if (scoreIdx !== -1) {\n    hashtags = hPart.substring(0, scoreIdx).trim();\n  } else {\n    hashtags = hPart.split('\\n\\n')[0].trim();\n  }\n}\n\n// --- Parse image URL ---\nvar imageUrl = '';\nvar urlParts = msgText.split('📎');\nif (urlParts.length > 1) {\n  imageUrl = urlParts[1].trim();\n}\n\n// Build Instagram caption\nvar instagramCaption = (caption && hashtags) ? caption + '\\n\\n' + hashtags : 'Check out this meme! 😂 #memes #funny #viral';\n\n// Build answer callback body\nvar answerBody = JSON.stringify({\n  callback_query_id: callbackId,\n  text: action === 'approve' ? '📤 Posting to Instagram...' : '⏭️ Skipped!'\n});\n\nreturn [{\n  json: {\n    action: action,\n    callbackId: callbackId,\n    chatId: chatId,\n    imageUrl: imageUrl,\n    instagramCaption: instagramCaption,\n    answerBody: answerBody\n  }\n}];"
      },
      "id": "f2a2b2c2-2222-4000-8000-000000000002",
      "name": "Parse Callback",
      "type": "n8n-nodes-base.code",
