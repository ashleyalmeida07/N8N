    {
      "parameters": {
        "jsCode": "var raw = $input.first().json;\nvar body = raw.body || raw;\nvar callback = body.callback_query;\nif (!callback || !callback.data) return [];\n\nvar action = callback.data;\nvar callbackId = callback.id;\nvar chatId = String(callback.message.chat.id);\nvar msgText = callback.message.caption || '';\n\n// Extract image URL: everything after \ud83d\udcce, trimmed\nvar imageUrl = '';\nvar urlParts = msgText.split('\ud83d\udcce');\nif (urlParts.length > 1) imageUrl = urlParts[1].trim().split(/\\s/)[0];\n\n// Extract title: text between \ud83d\udccc and \u2b06\ufe0f (upvotes marker)\nvar title = '';\nvar titleStart = msgText.indexOf('\ud83d\udccc');\nvar titleEnd = msgText.indexOf('\u2b06\ufe0f');\nif (titleStart !== -1) {\n  var titleBlock = titleEnd !== -1 ? msgText.substring(titleStart + 2, titleEnd) : msgText.substring(titleStart + 2);\n  title = titleBlock.trim();\n}\n\n// Skip bad titles: too short, has underscores (subreddit names), or generic\nvar badTitles = ['me_irl', 'meirl', 'memes', 'meme', 'funny', 'lol', 'bruh', 'oc', 'title'];\nvar isGoodTitle = title.length > 10 && !title.includes('_') && badTitles.indexOf(title.toLowerCase()) === -1;\n\n// Fun captions to rotate when title is bad\nvar funCaptions = ['Tag someone who needs to see this \ud83d\ude02', 'This is too accurate \ud83d\udc80\ud83d\ude02', 'I cant stop laughing \ud83e\udd23\ud83d\udd25', 'Who else can relate? \ud83d\ude2d\ud83d\ude02', 'Bro this is so true \ud83d\ude02\ud83d\udcaf', 'Send this to your bestie \ud83d\ude02\ud83e\udee1', 'POV: You saw this and lost it \ud83d\udc80', 'This one hits different \ud83d\ude02\ud83c\udfaf'];\nvar randomCaption = funCaptions[Math.floor(Math.random() * funCaptions.length)];\n\nvar captionText = isGoodTitle ? title + ' \ud83d\ude02\ud83d\udd25' : randomCaption;\n\nvar instagramCaption = captionText + '\\n.\\n.\\n.\\n#memes #funny #viral #trending #lol #memesdaily #humor #comedy #instamemes #relatable #dailymemes #funnymemes #memepage #explore #explorepage #memeoftheday #laugh #hilarious #jokes #dankmemes #funnyvideos #memesdank #comedymemes #trendingmemes #viralpost #reels #reelsinstagram #fyp';\n\n// Build Cloudinary URL: upscale to 1080px + heliomeme watermark\nvar processedUrl = 'https://res.cloudinary.com/rd4afqls/image/fetch/c_scale,w_1080,q_auto:best/l_text:Arial_12_bold:heliomeme,co_white,o_25,g_south_east,x_8,y_8/' + imageUrl;\n\nvar answerBody = JSON.stringify({\n  callback_query_id: callbackId,\n  text: action === 'approve' ? '\ud83d\udce4 Posting as Reel to Instagram...' : '\ud83d\udcdd Saving as draft...'\n});\n\nreturn [{ json: { action: action, callbackId: callbackId, chatId: chatId, imageUrl: imageUrl, processedUrl: processedUrl, instagramCaption: instagramCaption, answerBody: answerBody } }];"
      },
